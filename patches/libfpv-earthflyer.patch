+/* Earth Flyer patch (patches/libfpv-earthflyer.patch in earth-flyer):
+ * infinite battery keeps the pack's capacity full every step (voltage still
+ * sags under load; crash damage is untouched), and unlimited video range
+ * keeps the video link at the VTX's noise floor regardless of distance and
+ * obstacles. Both off by default; safe to call from any thread. */
+FPV_API void fpv_battery_set_infinite(int on);
+FPV_API void fpv_video_set_unlimited_range(int on);
+/* Earth Flyer patch: invert stick axes for every input source (radio,
+ * gamepad, keyboard; not host-injected channels). Bits by channel index:
+ * 1 roll, 2 pitch, 4 throttle, 8 yaw. 0 = none (default). */
+FPV_API void fpv_input_set_inverted(uint32_t axes_mask);
+
